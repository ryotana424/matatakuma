-# 全画面共通のグローバルヘッダー（デザイン準拠: ブランド＋フラットナビ＋現在地ハイライト）
-# current: :measure / :reports / :interventions / :about のいずれか。現在地を太字表示にする
- current ||= :measure
%header.fp-header
  = link_to root_path, class: "fp-brand" do
    %span.fp-brand__mark{ "aria-hidden": true }
    %span.fp-brand__name Matatakuma
  %nav.fp-nav{ "aria-label": "メイン" }
    - if current == :measure
      %span.fp-nav__here{ "aria-current": "page" } 計測
    - else
      = link_to "計測", root_path, class: "fp-nav__link"
    - if current == :reports
      %span.fp-nav__here{ "aria-current": "page" } 日次レポート
    - else
      = link_to "日次レポート", reports_path, class: "fp-nav__link", data: { turbo_frame: "modal" }
    - if current == :interventions
      %span.fp-nav__here{ "aria-current": "page" } 施策
    - else
      = link_to "施策", interventions_path, class: "fp-nav__link", data: { turbo_frame: "modal" }
    - if current == :about
      %span.fp-nav__here{ "aria-current": "page" } About
    - else
      = link_to "About", about_path, class: "fp-nav__link", data: { turbo_frame: "modal" }
