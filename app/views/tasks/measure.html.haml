- content_for(:title) { "計測中: #{@task.name} | Focus Pulse" }

.measure-page{ data: { controller: "measure", measure_task_id_value: @task.id, measure_create_url_value: task_sessions_path(@task) } }
  .page-head.measure-head
    %div
      %p.measure-kicker MEASUREMENT
      %h1.page-title= "計測中: #{@task.name}"
    = link_to "タスク一覧へ戻る", tasks_path, class: "btn btn--ghost"

  .measure-grid
    %section.panel.measure-camera{ "aria-label": "カメラ計測" }
      .measure-canvas-wrap
        %video{ data: { measure_target: "video" }, autoplay: true, playsinline: true, muted: true, style: "display:none" }
        %canvas.measure-canvas{ data: { measure_target: "canvas" }, width: "640", height: "480" }
        .measure-camera__empty{ data: { measure_target: "placeholder" } }
          %span.measure-camera__dot
          %span カメラ待機中
      .measure-camera-control
        %label.measure-camera-control__label{ for: "measure-camera-select" } カメラ
        %select#measure-camera-select.input.measure-camera-control__select{ disabled: true, data: { measure_target: "cameraSelect", action: "measure#changeCamera" } }
          %option カメラを確認中
      .measure-camera-control
        %label.measure-camera-control__label{ for: "measure-intervention-select" } 試す施策
        %select#measure-intervention-select.input.measure-camera-control__select{ data: { measure_target: "interventionSelect" } }
          %option{ value: "" } 施策なし
          - @interventions.each do |intervention|
            %option{ value: intervention.id }= intervention.name
      .measure-actions
        %button.btn.btn--finish{ type: "button", disabled: true, data: { action: "measure#stop", measure_target: "stopBtn" } }
          %span.btn--finish__icon{ "aria-hidden": true }
          %span 計測終了して保存

    %aside.panel.measure-score{ "aria-label": "集中度スコア" }
      .measure-score__label 現在の集中度
      .measure-score__value{ data: { measure_target: "score" } } --
      .measure-state{ data: { measure_target: "state" } } --
      .measure-message{ data: { measure_target: "message" } }
        カメラ許可後、スコアは1秒ごとに更新されます。

      .measure-pulse{ "aria-label": "集中度波形" }
        .measure-pulse__head
          %span 集中度波形
          %strong LIVE
        %canvas.measure-pulse__canvas{ data: { measure_target: "pulseCanvas" }, width: "360", height: "96" }

      .measure-breakdown
        .measure-breakdown__item
          %span 瞬き回数
          %strong{ data: { measure_target: "blinkCount" } } 0
        .measure-breakdown__item
          %span 保存対象
          %strong 集計済み数値のみ
        .measure-breakdown__item
          %span 映像
          %strong サーバ送信なし
        .measure-breakdown__item
          %span ランドマーク
          %strong ブラウザ内処理
