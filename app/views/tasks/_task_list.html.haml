-# タスク一覧＋タスク追加モーダル。index と measure の両画面から共通利用する
-# ステータスenum値（todo/doing/done/archived/interrupted）→ 日本語ラベルへの対応表
- status_labels = { "todo" => "未着手", "doing" => "着手中", "done" => "完了", "archived" => "アーカイブ", "interrupted" => "中断" }
- status_action_options = [["未着手", "todo"], ["着手中", "doing"], ["完了", "done"], ["アーカイブ", "archived"], ["中断", "interrupted"]]

-# open value は .to_s で文字列化する（Hamlは属性値がfalseだと属性自体を省略するため）
.task-panel{ data: { controller: "task-modal", task_modal_open_value: form_task.errors.any?.to_s } }
  .task-panel__head
    %h2.task-panel__title タスク一覧
    %button.btn.btn--primary{ type: "button", data: { action: "task-modal#open" } } ＋ タスク追加

  - if tasks.any?
    %table.task-table.panel
      %thead
        %tr
          %th タスク
          %th 状態
          %th 計測時間合計
          %th 集中度総量
          %th 平均集中スコア
          %th{ "aria-label": "操作" }
      %tbody
        - tasks.each do |task|
          %tr
            %td.task-name{ "data-label": "タスク" }= task.name
            %td{ "data-label": "状態" }
              - if task.sessions.exists?
                = form_with model: task, url: task_path(task), method: :patch, class: "task-status-form" do |f|
                  = f.select :status, status_action_options, { selected: task.status }, class: "status-pill task-status-select status-pill--#{task.status}", "aria-label": "#{task.name}の状態", onchange: "this.form.requestSubmit()"
              - else
                %span.status-pill{ class: "status-pill--#{task.status}" }= status_labels[task.status]
            %td.task-duration{ "data-label": "計測時間合計" }= format_duration(task.total_duration_sec)
            %td.task-duration{ "data-label": "集中度総量" }= task.focus_volume ? format_focus_volume(task.focus_volume) : "--"
            %td.task-duration{ "data-label": "平均集中スコア" }= task.average_score || "--"
            %td{ "data-label": "操作" }
              .task-actions
                - if current_task == task
                  %span.measure-link.measure-link--current 計測中
                - else
                  = link_to measure_task_path(task), class: "measure-link" do
                    %svg{ width: "15", height: "15", viewBox: "0 0 24 24", fill: "currentColor", "aria-hidden": "true" }
                      %path{ d: "M8 5v14l11-7z" }
                    計測開始
  - else
    .panel.empty-state
      %p.empty-state__title まだタスクがありません
      %p 「＋ タスク追加」から最初のタスクを追加してください。

  -# タスク追加モーダル（静的コンテンツ。開閉は task-modal コントローラ）
  .modal-overlay.task-modal{ data: { task_modal_target: "overlay", action: "click->task-modal#backdrop keydown.esc@window->task-modal#close" } }
    .modal-dialog.task-modal__dialog{ role: "dialog", "aria-modal": "true" }
      %button.modal-close{ type: "button", "aria-label": "閉じる", data: { action: "task-modal#close" } } ✕
      %h2.task-modal__title タスクを追加
      = form_with model: form_task, url: tasks_path, class: "task-form task-form--modal" do |f|
        = f.text_field :name, placeholder: "タスク名を入力", class: "input", "aria-label": "タスク名"
        = f.submit "追加", class: "btn btn--primary"
        - if form_task.errors[:name].present?
          %span.field-error= "タスク名#{form_task.errors[:name].first}"
