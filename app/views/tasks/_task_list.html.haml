-# タスク一覧＋タスク追加モーダル。index と measure の両画面から共通利用する
- status_action_options = [["未着手", "todo"], ["着手中", "doing"], ["完了", "done"], ["アーカイブ", "archived"], ["中断", "interrupted"]]
- active_statuses = %w[todo doing interrupted]
- active_tasks_present = tasks.any? { |task| task == current_task || active_statuses.include?(task.status) }

-# open value は .to_s で文字列化する（Hamlは属性値がfalseだと属性自体を省略するため）
%section.task-panel.panel{ "aria-label": "タスク一覧", data: { controller: "task-modal task-list-filter", task_modal_open_value: form_task.errors.any?.to_s } }
  .task-panel__head
    %h2.task-panel__title タスク一覧
    .task-list-filter.segmented{ role: "group", "aria-label": "タスク表示切替" }
      %button.segmented__btn.segmented__btn--active{ type: "button", "aria-pressed": "true", data: { task_list_filter_target: "button", task_list_filter_filter_param: "active", action: "task-list-filter#select" } } 進行中
      %button.segmented__btn{ type: "button", "aria-pressed": "false", data: { task_list_filter_target: "button", task_list_filter_filter_param: "finished", action: "task-list-filter#select" } } 終了済
    %button.btn.btn--ghost.task-panel__add{ type: "button", data: { action: "task-modal#open" } } ＋ タスク追加

  - if tasks.any?
    .task-grid
      .task-grid__head
        %span タスク名
        %span 状態
        %span.task-grid__num 計測時間合計
        %span.task-grid__num 集中度総量
        %span.task-grid__num 平均集中スコア
        %span 操作
      - tasks.each do |task|
        - measuring = current_task == task
        - group = measuring || active_statuses.include?(task.status) ? "active" : "finished"
        .task-grid__row{ class: ("task-grid__row--measuring" if measuring), hidden: (group == "finished"), data: { task_list_filter_target: "row", task_list_filter_group: group } }
          %span.task-grid__name
            = task.name
            - if measuring
              %span.task-grid__measuring
                %span.task-grid__measuring-dot{ "aria-hidden": true }
                計測中
          %span
            = form_with model: task, url: task_path(task), method: :patch, class: "task-status-form" do |f|
              = f.select :status, status_action_options, { selected: task.status }, class: "status-pill task-status-select status-pill--#{task.status}", "aria-label": "#{task.name}の状態", onchange: "this.form.requestSubmit()"
          %span.task-grid__num.task-grid__mono= format_duration(task.total_duration_sec)
          %span.task-grid__num.task-grid__mono= task.focus_volume ? format_focus_volume(task.focus_volume) : "—"
          %span.task-grid__score
            %span.task-grid__bar{ "aria-hidden": true }
              %span.task-grid__bar-fill{ style: "width:#{task.average_score || 0}%" }
            %span.task-grid__mono= task.average_score || "—"
          %span.task-grid__ops
            - if measuring
              %button.task-btn.task-btn--stop{ type: "button", data: { action: "measure#stop" } }
                %span.task-btn__stop-icon{ "aria-hidden": true }
                計測終了
            - else
              = link_to measure_task_path(task), class: "task-btn" do
                %span.task-btn__play-icon{ "aria-hidden": true }
                計測開始
  .empty-state{ hidden: active_tasks_present, data: { task_list_filter_target: "empty", task_list_filter_group: "active" } }
    - if tasks.empty?
      %p.empty-state__title まだタスクがありません
      %p 「＋ タスク追加」から最初のタスクを追加してください。
    - else
      %p.empty-state__title 進行中のタスクはありません
      %p 「終了済」に切り替えると完了・アーカイブしたタスクを確認できます。

  .empty-state{ hidden: true, data: { task_list_filter_target: "empty", task_list_filter_group: "finished" } }
    %p.empty-state__title 終了済のタスクはありません
    %p 完了またはアーカイブしたタスクがここに表示されます。

  -# タスク追加モーダル（静的コンテンツ。開閉は task-modal コントローラ）
  .modal-overlay.task-modal{ data: { task_modal_target: "overlay", action: "click->task-modal#backdrop keydown.esc@window->task-modal#close" } }
    .modal-dialog.task-modal__dialog{ role: "dialog", "aria-modal": "true" }
      %button.modal-close{ type: "button", "aria-label": "閉じる", data: { action: "task-modal#close" } } ✕
      %h2.task-modal__title タスクを追加
      = form_with model: form_task, url: tasks_path, class: "task-form task-form--modal" do |f|
        = f.text_field :name, placeholder: "タスク名を入力", class: "input", "aria-label": "タスク名"
        = f.submit "追加", class: "btn btn--primary"
        - if form_task.errors[:name].present?
          %span.field-error= "タスク名#{form_task.errors[:name].first}"
