!!!
%html{ lang: "ja" }
  %head
    %title= content_for(:title) || "Focus Pulse"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "application-name", content: "Focus Pulse" }
    %meta{ name: "mobile-web-app-capable", content: "yes" }
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    -# Google Fonts（デザインシステムのフォント: IBM Plex Sans JP + IBM Plex Mono）
    %link{ rel: "preconnect", href: "https://fonts.googleapis.com" }
    %link{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true }
    %link{ rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" }

    -# テーマ（自動/ライト/ダーク）。FOUC回避のため描画前に data-theme を復元する
    :javascript
      (function () {
        try {
          var t = localStorage.getItem("fp-theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();

    %link{ rel: "icon", href: "/icon.png", type: "image/png" }
    %link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
    %link{ rel: "apple-touch-icon", href: "/icon.png" }

    = stylesheet_link_tag :application, "data-turbo-track": "reload"
    %script{ src: "https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" }
    %script{ src: "https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" }
    = javascript_importmap_tags

  %body
    .app-shell
      %header.app-header
        = link_to root_path, class: "app-brand" do
          %span.app-brand__mark
            %svg{ width: "18", height: "18", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round" }
              %circle{ cx: "12", cy: "12", r: "3" }
              %path{ d: "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" }
          %span
            %span.app-brand__name Focus Pulse
            %span.app-brand__sub 集中力を記録する
        %nav.app-nav{ "aria-label": "グローバルナビゲーション" }
          = link_to "説明", about_path, class: "app-nav-link", data: { turbo_frame: "modal" }
          = link_to "日次レポート", reports_path, class: "app-nav-link", data: { turbo_frame: "modal" }
          = link_to "施策", interventions_path, class: "app-nav-link", data: { turbo_frame: "modal" }
          %div.segmented{ role: "group", "aria-label": "テーマ切替", data: { controller: "theme" } }
            %button.segmented__btn{ type: "button", data: { theme_target: "btn", theme_theme_param: "auto", action: "theme#select" } } 自動
            %button.segmented__btn{ type: "button", data: { theme_target: "btn", theme_theme_param: "light", action: "theme#select" } } ライト
            %button.segmented__btn{ type: "button", data: { theme_target: "btn", theme_theme_param: "dark", action: "theme#select" } } ダーク

      - if notice.present?
        .flash= notice

      = yield

    -# 計測を止めずに説明・レポートを開くためのモーダル枠（全ページ共通）
    .modal-overlay{ data: { controller: "modal", action: "click->modal#backdrop keydown.esc@window->modal#close" } }
      .modal-dialog{ role: "dialog", "aria-modal": "true", data: { modal_target: "dialog" } }
        %button.modal-close{ type: "button", "aria-label": "閉じる", data: { action: "modal#close" } } ✕
        = turbo_frame_tag "modal", class: "modal-frame", data: { modal_target: "frame" }
