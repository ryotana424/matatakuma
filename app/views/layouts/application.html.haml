!!!
%html{ lang: "ja" }
  %head
    %title= content_for(:title) || "Focus Pulse"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "application-name", content: "Focus Pulse" }
    %meta{ name: "mobile-web-app-capable", content: "yes" }
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    -# Google Fonts（共通デザインシステムのフォント: Outfit + JetBrains Mono）
    %link{ rel: "preconnect", href: "https://fonts.googleapis.com" }
    %link{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true }
    %link{ rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Outfit:wght@400;500;600;700&display=swap" }

    %link{ rel: "icon", href: "/icon.png", type: "image/png" }
    %link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
    %link{ rel: "apple-touch-icon", href: "/icon.png" }

    = stylesheet_link_tag :application, "data-turbo-track": "reload"
    %script{ src: "https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" }
    %script{ src: "https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" }
    %script{ src: "https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" }
    = javascript_importmap_tags

  %body
    .app-shell
      %header.app-header
        = link_to root_path, class: "app-brand" do
          %span.app-brand__mark
            %svg{ width: "18", height: "18", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round" }
              %circle{ cx: "12", cy: "12", r: "3" }
              %path{ d: "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" }
          %span
            %span.app-brand__name Focus Pulse
            %span.app-brand__sub 集中力を記録する
        %nav.app-nav{ "aria-label": "グローバルナビゲーション" }
          = link_to "説明", about_path, class: "app-nav-link"
          = link_to "日次レポート", reports_path, class: "app-nav-link"

      - if notice.present?
        .flash= notice

      = yield
